# API keys for optional higher-quality data providers.
# The system runs without any of these using free sources (Stooq, Yahoo, FRED)
# or, offline, the deterministic synthetic provider.

# https://www.tiingo.com  (free tier: EOD prices)
TIINGO_API_KEY=

# https://polygon.io  (paid: prices, corporate actions, fundamentals)
POLYGON_API_KEY=

# https://www.alphavantage.co  (free tier: rate-limited EOD + fundamentals)
ALPHAVANTAGE_API_KEY=

# https://fred.stlouisfed.org/docs/api/api_key.html  (free; the CSV fallback
# used by the FRED adapter needs no key, an API key raises rate limits)
FRED_API_KEY=

# https://site.financialmodelingprep.com  (fundamentals)
FMP_API_KEY=
